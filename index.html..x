<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="iFixit Pro — মোবাইল সার্ভিসিং, রিপেয়ার ও অ্যাকসেসরিজ।">
<title>iFixit Pro | Mobile Service & Accessories</title>
<style>
:root{--bg:#0b1020;--panel:#121a2e;--panel2:#17223a;--text:#f6f8ff;--muted:#aeb9d2;--accent:#41e0b3;--blue:#5a8cff;--line:#293653}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}
header{position:sticky;top:0;background:#0b1020ed;backdrop-filter:blur(12px);border-bottom:1px solid var(--line);z-index:10}.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 0}.brand{font-size:1.4rem;font-weight:900;letter-spacing:-.5px}.brand span{color:var(--accent)}nav{display:flex;gap:20px;align-items:center;font-size:.95rem;color:var(--muted)}nav a:hover{color:var(--accent)}.menu{display:none;background:none;border:1px solid var(--line);color:white;padding:7px 10px;border-radius:10px}
.hero{padding:78px 0 64px;background:radial-gradient(ellipse at 75% 15%,#1b3c56 0,transparent 45%),linear-gradient(135deg,#0b1020,#101a30)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:38px;align-items:center}.eyebrow{display:inline-block;border:1px solid #2e655e;background:#12312e;color:var(--accent);padding:5px 12px;border-radius:99px;font-size:.85rem}.hero h1{font-size:clamp(2.4rem,5vw,4.7rem);line-height:1.12;margin:18px 0}.hero h1 span{color:var(--accent)}.hero p{color:var(--muted);font-size:1.08rem;max-width:590px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:12px;font-weight:750;border:1px solid var(--line);transition:.2s}.primary{background:var(--accent);color:#06231d;border-color:var(--accent)}.btn:hover{transform:translateY(-2px)}.visual{min-height:340px;border:1px solid #344362;border-radius:28px;background:linear-gradient(145deg,#1a2944,#101827);padding:24px;display:grid;place-items:center;position:relative;overflow:hidden}.phone{width:175px;height:285px;border:7px solid #a8b6ce;border-radius:30px;background:linear-gradient(160deg,#203e58,#101827);box-shadow:0 25px 60px #0008;display:flex;align-items:center;justify-content:center;position:relative}.phone:before{content:"";position:absolute;top:8px;width:55px;height:7px;border-radius:8px;background:#a8b6ce}.phone strong{font-size:1.5rem;text-align:center;line-height:1.2}.phone strong span{color:var(--accent)}.float{position:absolute;background:#1b2942;border:1px solid #3a4b6b;border-radius:14px;padding:10px 13px;font-weight:700}.float.one{top:30px;left:20px}.float.two{right:16px;bottom:35px}
section{padding:68px 0}.section-head{text-align:center;max-width:700px;margin:0 auto 32px}.section-head h2{font-size:clamp(1.8rem,3vw,2.7rem);margin:0 0 8px}.section-head p{color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:23px}.icon{width:48px;height:48px;border-radius:14px;background:#183a3a;display:grid;place-items:center;font-size:1.5rem;margin-bottom:14px}.card h3{margin:0 0 8px}.card p{color:var(--muted);margin:0}.about{background:#0f1729;border-block:1px solid var(--line)}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}.about h2{font-size:2.3rem;line-height:1.2;margin:0 0 16px}.about p{color:var(--muted)}.checks{display:grid;gap:10px;margin-top:18px}.checks div:before{content:"✓";color:var(--accent);font-weight:900;margin-right:10px}.info-box{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:25px}.info-row{padding:13px 0;border-bottom:1px solid var(--line)}.info-row:last-child{border:0}.info-row small{display:block;color:var(--muted)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.contact-card{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:25px}.contact-card p{color:var(--muted)}.notice{font-size:.88rem;color:var(--muted);background:#101a2c;border:1px dashed #405174;border-radius:12px;padding:13px;margin-top:18px}
footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted)}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
@media(max-width:760px){.hero-grid,.about-grid,.contact-grid{grid-template-columns:1fr}.hero{padding-top:48px}.visual{min-height:300px}.cards{grid-template-columns:1fr}.nav{flex-wrap:wrap}nav{display:none;width:100%;flex-direction:column;align-items:flex-start;padding:10px 0 15px}.menu{display:block}nav.open{display:flex}.brand{font-size:1.25rem}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="#home">iFixit <span>Pro</span></a><button class="menu" onclick="document.querySelector('nav').classList.toggle('open')" aria-label="মেনু খুলুন">☰ মেনু</button><nav><a href="#home">হোম</a><a href="#services">সার্ভিস</a><a href="#about">আমাদের সম্পর্কে</a><a href="#contact">যোগাযোগ</a></nav></div></header>
<main>
<section class="hero" id="home"><div class="wrap hero-grid"><div><span class="eyebrow">Mobile Service • Repair • Accessories</span><h1>আপনার মোবাইলের<br><span>বিশ্বস্ত সার্ভিস</span></h1><p>iFixit Pro-তে মোবাইল সার্ভিসিং, সমস্যা নির্ণয় ও অ্যাকসেসরিজ সম্পর্কে জানতে যোগাযোগ করুন। আপনার ডিভাইসের যত্নে আমরা গুরুত্ব দিই।</p><div class="actions"><a class="btn primary" href="#contact">যোগাযোগ করুন</a><a class="btn" href="#services">সার্ভিস দেখুন ↓</a></div></div><div class="visual" aria-label="iFixit Pro mobile service illustration"><div class="float one">🛠️ Expert Care</div><div class="phone"><strong>iFixit<br><span>Pro</span></strong></div><div class="float two">📱 Mobile Service</div></div></div></section>
<section id="services"><div class="wrap"><div class="section-head"><h2>আমাদের সার্ভিস</h2><p>আপনার দোকানের প্রকৃত সার্ভিস অনুযায়ী এই তালিকা সম্পাদনা করে নেবেন।</p></div><div class="cards">
<article class="card"><div class="icon">🔧</div><h3>মোবাইল রিপেয়ার</h3><p>মোবাইলের বিভিন্ন হার্ডওয়্যার সমস্যার পরীক্ষা ও মেরামত।</p></article>
<article class="card"><div class="icon">🖥️</div><h3>সফটওয়্যার সার্ভিস</h3><p>সমস্যা নির্ণয়, সফটওয়্যার সংক্রান্ত সহায়তা ও প্রয়োজনীয় সার্ভিস।</p></article>
<article class="card"><div class="icon">🎧</div><h3>অ্যাকসেসরিজ</h3><p>মোবাইল অ্যাকসেসরিজ ও প্রয়োজনীয় পণ্য সম্পর্কে খোঁজ নিন।</p></article>
</div></div></section>
<section class="about" id="about"><div class="wrap about-grid"><div><h2>iFixit Pro সম্পর্কে</h2><p>iFixit Pro একটি মোবাইল সার্ভিসিং ও অ্যাকসেসরিজ ব্যবসার ওয়েবসাইট। এখানে গ্রাহকরা সার্ভিসের তথ্য, যোগাযোগের নম্বর এবং দোকানের ঠিকানা সহজে খুঁজে পাবেন।</p><div class="checks"><div>সহজ যোগাযোগ</div><div>সার্ভিসের তথ্য এক জায়গায়</div><div>মোবাইল-ফ্রেন্ডলি ডিজাইন</div></div></div><div class="info-box"><h3>দোকানের তথ্য</h3><div class="info-row"><small>ব্যবসার নাম</small><strong>iFixit Pro</strong></div><div class="info-row"><small>ঠিকানা</small><strong>Monirampur Bazar, Shahzadpur, Sirajganj, Bangladesh</strong></div><div class="info-row"><small>ফোন / WhatsApp</small><strong>01832744435</strong></div><div class="info-row"><small>Facebook</small><a href="https://www.facebook.com/ifixitpro.bd" target="_blank" rel="noopener">facebook.com/ifixitpro.bd ↗</a></div></div></div></section>
<section id="contact"><div class="wrap"><div class="section-head"><h2>যোগাযোগ করুন</h2><p>সার্ভিস সম্পর্কে জানতে ফোন করুন অথবা Facebook পেজে মেসেজ দিন।</p></div><div class="contact-grid"><div class="contact-card"><h3>📞 ফোন / WhatsApp</h3><p>সরাসরি যোগাযোগ করুন: 01832744435</p><div class="action
